# Docker Environment Configuration for SEO
# Add these to your Digital Ocean deployment

# Required: Domain configuration
CANONICAL_URL=https://onlinemcpinspector.com

# Optional: Analytics (add when ready)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ADS_CLIENT_ID=ca-pub-XXXXXXXXXX

# Production settings
NODE_ENV=production
VITE_NODE_ENV=production

# MCP Inspector settings (already in Dockerfile)
CLIENT_PORT=6274
SERVER_PORT=6277

# Security settings for production
DANGEROUSLY_OMIT_AUTH=false
HOST=127.0.0.1

# Performance settings
VITE_ENABLE_ANALYTICS_IN_DEV=false

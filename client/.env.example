# Analytics Configuration
# Copy to .env.local and update with your actual IDs

# Google Analytics Measurement ID (GA4)
# Get this from Google Analytics 4 property
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads Client ID
# Get this from Google Ads account
VITE_GOOGLE_ADS_CLIENT_ID=ca-pub-XXXXXXXXXX

# Environment
VITE_NODE_ENV=production

# Enable/disable analytics in development
VITE_ENABLE_ANALYTICS_IN_DEV=false
